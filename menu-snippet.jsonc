{
  // Copy these rows into ~/.config/omarchy/extensions/omarchy-menu.jsonc
  // Super+Space → Style → Live wallpaper
  // Menu providers (fonts/apps) are first-party-only in Menu.qml, so effects are static rows.
  "style.live-wallpaper": {"icon":"󱦟","label":"Live wallpaper","aliases":["live-wallpaper","ttfx"]},
  "style.live-wallpaper.enable": {"icon":"󰐼","label":"Enable","checked":"pgrep -f '[o]rg.omarchy.wallpaper-screensaver'","action":"omarchy plugin disable omarchy.background >/dev/null 2>&1 || true; omarchy plugin enable live-ttfx-wallpaper >/dev/null 2>&1 || true; \"$HOME/.config/omarchy/plugins/live-ttfx-wallpaper/bin/omarchy-launch-wallpaper-screensaver\""},
  "style.live-wallpaper.restore": {"icon":"","label":"Restore static wallpaper","action":"\"$HOME/.config/omarchy/plugins/live-ttfx-wallpaper/bin/omarchy-launch-wallpaper-screensaver\" --stop; omarchy plugin disable live-ttfx-wallpaper >/dev/null 2>&1 || true; omarchy plugin enable omarchy.background"},
  "style.live-wallpaper.speed": {"icon":"󰥔","label":"Speed"},
  "style.live-wallpaper.speed.10": {"icon":"󰥔","label":"10","checked":"\"$HOME/.config/omarchy/plugins/live-ttfx-wallpaper/bin/omarchy-live-wallpaper-ctl\" is-speed 10","action":"\"$HOME/.config/omarchy/plugins/live-ttfx-wallpaper/bin/omarchy-live-wallpaper-ctl\" set-speed 10"},
  "style.live-wallpaper.speed.15": {"icon":"󰥔","label":"15","checked":"\"$HOME/.config/omarchy/plugins/live-ttfx-wallpaper/bin/omarchy-live-wallpaper-ctl\" is-speed 15","action":"\"$HOME/.config/omarchy/plugins/live-ttfx-wallpaper/bin/omarchy-live-wallpaper-ctl\" set-speed 15"},
  "style.live-wallpaper.speed.30": {"icon":"󰥔","label":"30","checked":"\"$HOME/.config/omarchy/plugins/live-ttfx-wallpaper/bin/omarchy-live-wallpaper-ctl\" is-speed 30","action":"\"$HOME/.config/omarchy/plugins/live-ttfx-wallpaper/bin/omarchy-live-wallpaper-ctl\" set-speed 30"},
  "style.live-wallpaper.speed.60": {"icon":"󰥔","label":"60","checked":"\"$HOME/.config/omarchy/plugins/live-ttfx-wallpaper/bin/omarchy-live-wallpaper-ctl\" is-speed 60","action":"\"$HOME/.config/omarchy/plugins/live-ttfx-wallpaper/bin/omarchy-live-wallpaper-ctl\" set-speed 60"},
  "style.live-wallpaper.speed.90": {"icon":"󰥔","label":"90","checked":"\"$HOME/.config/omarchy/plugins/live-ttfx-wallpaper/bin/omarchy-live-wallpaper-ctl\" is-speed 90","action":"\"$HOME/.config/omarchy/plugins/live-ttfx-wallpaper/bin/omarchy-live-wallpaper-ctl\" set-speed 90"},
