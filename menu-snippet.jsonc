  "style.live-wallpaper.text.set": {"icon":"","label":"Set text","action":"omarchy-launch-tui --app-id=org.omarchy.live-wallpaper-text \"$HOME/.config/omarchy/plugins/live-ttfx-wallpaper/bin/omarchy-live-wallpaper-text\""},
  "style.live-wallpaper.text.raw": {"icon":"","label":"Edit raw file","action":"omarchy-launch-editor \"$HOME/.config/omarchy/branding/screensaver.txt\""},
